{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentEvent",
  "description": "Normalized harness timeline unit.",
  "type": "object",
  "required": ["id", "run_id", "kind", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "run_id": { "type": "string" },
    "turn_id": { "type": "string" },
    "kind": { "type": "string" },
    "payload": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

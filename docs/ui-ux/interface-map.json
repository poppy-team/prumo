{
  "id": "ui:prumo-tui",
  "version": 1,
  "surface": "prumo-tui — the shipping terminal client (chat shell, dialogs, statusline)",
  "note": "Canonical interface map for the terminal client that ships: ADR 013 built it on the archived OpenCode Go view layer and the from-scratch client moved to `archive/tui/`, which keeps its own map beside it. Structure, labels, intent and placement are declared here; symbols are proven against `prumo-tui/**/*.go` by `prumo ui verify`. A declared element always wins over a derived one, and divergence is a finding rather than a silent pick. States come from `docs/ui-ux/state-matrix.json`, which describes this same surface.",
  "platforms": [
    "tui"
  ],
  "states_source": "docs/ui-ux/state-matrix.json",
  "tokens_source": "docs/ui-ux/design-tokens.json",
  "derivation": {
    "sources": [
      "prumo-tui/**/*.go"
    ],
    "mode": "verify-only"
  },
